{
  "app": {
    // 与 Android applicationId 保持一致；如需上架 AGC 以平台分配的为准
    "bundleName": "io.github.yibohub.localfamily_asset",
    "vendor": "yibohub",
    // 与 flutter_app/pubspec.yaml 的 version（0.3.0+2）保持一致；
    // ohos Flutter SDK 构建时会从 pubspec 同步覆写
    "versionCode": 2,
    "versionName": "0.3.0",
    "icon": "$media:app_icon",
    "label": "$string:app_name"
  }
}
