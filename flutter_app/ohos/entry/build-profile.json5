{
  "apiType": "stageMode",
  "buildOption": {
    // 预编译动态库（Rust Core 的 liblocalfamily_asset_core.so）放在本模块
    // libs/<abi>/ 目录，hvigor 会自动打入 HAP，无需在此配置
  },
  "buildOptionSet": [
    {
      "name": "release",
      "arkOptions": {
        "obfuscation": {
          "ruleOptions": {
            "enable": false,
            "files": [
              "./obfuscation-rules.txt"
            ]
          }
        }
      }
    }
  ],
  "targets": [
    {
      "name": "default"
    }
  ]
}
